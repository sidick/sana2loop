# M16 on-target test fixture: loss=1 -- EVERY write on unit 17 succeeds
# from the writer's point of view (io_Error stays 0) but the packet
# silently never arrives, proven by a pre-queued typed CMD_READ still
# sitting unanswered afterward (drained via AbortIO). N=1 is the exact,
# PRNG-free boundary, same reasoning as unit16.config. Needs its own
# unit for the same reason too: silently vanishing all traffic would
# break any other unit's delivery-asserting sub-tests.
loss=1
