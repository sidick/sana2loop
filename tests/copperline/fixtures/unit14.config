# M14 on-target test fixture: replaycap=0 is out of range (minimum 1) --
# this must fail config VALIDATION alone (parse_config_line(), before any
# mode=replay/allocation logic even runs), so OpenDevice() fails outright
# with S2ERR_BAD_ARGUMENT. Deliberately the ONLY on-target coverage for
# `replaycap=` in this session -- the positive case (a raised cap actually
# loading more records than the default) needs a real replay-mode
# allocation, which reliably exceeds bundled AROS's tight memory budget at
# this point in the sequence; see docs/PLAN.md's M14 risk note for the
# full investigation and why that case is verified via real hardware
# (Kickstart 1.3/3.1) locally instead.
replaycap=0
