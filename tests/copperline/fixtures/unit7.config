# M7 on-target test fixture: reorder=3 with a fixed seed -- the test
# asserts the EXACT delivery permutation this seed/window combination
# produces (precomputed on the host with a Python replica of the
# device's xorshift32 + prng_index algorithm; see sana2test.c's
# "reorder" sub-test comment for the derivation).
seed=7
reorder=3
