# M11 on-target test fixture: SanaSend/SanaDump round-trip. rxqueue=5
# means SanaDump doesn't need its own queued read already in place before
# SanaSend writes -- see run-tools.sh's own comment for why SanaDump
# still has to be the one that opens the unit FIRST and stays open across
# both (its own OpenDevice() is what keeps the open count above 0, so
# SanaSend's later close-on-exit doesn't trigger reset_unit() and discard
# what got buffered here).
rxqueue=5
