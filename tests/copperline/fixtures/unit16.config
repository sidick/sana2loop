# M16 on-target test fixture: errors=1 -- EVERY write on unit 16 must
# fail visibly with S2ERR_TX_FAILURE/S2WERR_TOO_MANY_RETRIES and fire
# S2EVENT_TX|S2EVENT_ERROR to any queued S2_ONEVENT (the "faulterrors"
# sub-test queues one and asserts it completes). N=1 is the exact,
# PRNG-free boundary, so the test is deterministic by construction.
# Needs its own unit: a knob that makes every plain write fail would
# break any other unit's own sub-test riding the same fixture.
errors=1
