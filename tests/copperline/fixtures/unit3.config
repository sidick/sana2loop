# M7 on-target test fixture: unit 3 stays the M6 default crossover peer
# of unit 2 (mode/peer untouched), but gets a smaller mtu so a write from
# unit 2 that's within unit 2's own (larger, default 1500) MTU but over
# unit 3's can exercise M7's oversilent/PMTUD-black-hole path. Harmless to
# M6's own crossover sub-test: that test only ever writes 20-byte
# payloads, far under even this smaller MTU.
mtu=500
