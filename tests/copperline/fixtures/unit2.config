# M7 on-target test fixture: unit 2 stays the M6 default crossover peer
# of unit 3 (mode/peer untouched, inherited from reset_unit()'s compiled
# default), but also gets oversilent=1 for M7's PMTUD-black-hole test.
# Harmless to M6's own crossover sub-test: that test only ever writes
# 20-byte payloads, far under any MTU this device supports, so oversilent
# (which only matters once a write actually exceeds the peer's MTU) never
# fires there.
oversilent=1
