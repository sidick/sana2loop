# M17 on-target test fixture: delay=10 deviation=0 -- a fixed, PRNG-free
# 10-tick (~200ms at 50Hz) delivery latency on unit 18. The "delay" sub-
# test asserts (a) a queued CMD_READ does NOT complete immediately after
# a matching write (still pending right after do_io() returns -- proven
# via a non-blocking CheckIO()-style poll, not WaitIO(), which would just
# block until it eventually completes and prove nothing about timing),
# and (b) it DOES complete once enough VBlanks have actually elapsed.
# deviation=0 keeps the exact due tick deterministic for the assertion;
# jitter (deviation>0) is exercised only informally (see
# docs/sana2-notes.md's M17 section) since asserting a RANGE of
# acceptable completion ticks on-target adds harness complexity for
# little extra coverage over the fixed-delay case.
delay=10
